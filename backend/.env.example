# Copy to .env (or set as environment variables). All optional.

# AI provider: auto | groq | gemini | claude | ollama | mock   (default: auto)
# "auto" picks: Claude > hosted(OpenAI-compatible) > Ollama > rule-based fallback.
AI_PROVIDER=auto

# ── FREE hosted LLM (recommended) ───────────────────────────────────────────
# Works with Groq (default), Google Gemini, OpenRouter, Together, OpenAI.
# Get a FREE Groq key (no credit card): https://console.groq.com/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_JSON_MODE=true
# For Google Gemini free tier instead, use:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-2.0-flash
#   (key from https://aistudio.google.com/apikey)

# ── Claude (best quality, paid) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Ollama (fully local/offline) ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Email sending (SMTP) ─────────────────────────────────────────────────────
# Leave SMTP_HOST empty to run in "log" mode (emails are saved to the DB + printed
# to the console, never sent) — fine for dev. Set it to start sending for real.
# Every free provider below gives you SMTP credentials, so NO code change is needed.
#
#   Brevo    300/day free, no card   smtp-relay.brevo.com   :587   (RECOMMENDED)
#   Mailjet  200/day free            in-v3.mailjet.com      :587
#   SendGrid 100/day free            smtp.sendgrid.net      :587   user = "apikey"
#   Resend   100/day free            smtp.resend.com        :587   user = "resend"
#   Gmail    ~500/day                smtp.gmail.com         :587   needs an App Password (2FA on)
#
# SMTP_USER/SMTP_PASSWORD are the provider's SMTP login + key (NOT your dashboard
# password). EMAIL_FROM must be a verified sender / domain on the provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=talent@example.com
EMAIL_FROM_NAME=Talent Team

# ── Authentication ──────────────────────────────────────────────────────────
# SECRET_KEY signs login tokens — set a long random value in production (else tokens
# are forgeable). First-run creates a bootstrap admin from ADMIN_EMAIL/ADMIN_PASSWORD
# (if ADMIN_PASSWORD is blank, a random one is generated and printed to the logs once).
SECRET_KEY=
ADMIN_EMAIL=admin@hr-os.local
ADMIN_PASSWORD=

# Database
DATABASE_URL=sqlite:///./hr_os.db

# CORS (frontend origin)
FRONTEND_ORIGIN=http://localhost:5173

# ── Company / careers page (shown on public pages + job-board feeds) ─────────
COMPANY_NAME=Our Company
COMPANY_WEBSITE=
COMPANY_COUNTRY=India
EMAIL_FROM=talent@example.com

# ── FREE job distribution ───────────────────────────────────────────────────
# Public URL where the careers site is deployed, e.g. https://careers.acme.com
# Job aggregators (Adzuna, Jooble, Careerjet, Talent.com, Jora, …) crawl ABSOLUTE
# urls, so set this in production. Empty in dev = uses the request host (localhost,
# which external crawlers cannot reach — fine for previewing the feeds locally).
# REQUIRED for the automated direct-posting integrations below.
PUBLIC_BASE_URL=

# ── Automated DIRECT posting (optional; no-op until set) ─────────────────────
# Google for Jobs via the Indexing API (FREE): pings Google to (re)crawl each
# JobPosting URL within minutes. Create a GCP service account, enable the Indexing
# API, add it as an owner of your careers domain in Search Console, then paste the
# key here as inline JSON (best for hosting) OR a file path. Needs PUBLIC_BASE_URL.
GOOGLE_INDEXING_SA_JSON=
# GOOGLE_INDEXING_SA_FILE=/path/to/service-account.json

# LinkedIn company-page auto-share (FREE): posts a job announcement to your Company
# Page (not a native job listing — that API is partner-only). Create a LinkedIn
# developer app, get an org access token with the w_organization_social scope, and
# set your organization URN. You must be an admin of the page.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=
# LINKEDIN_ORG_URN=urn:li:organization:1234567
